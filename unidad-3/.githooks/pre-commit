#!/bin/sh
# Pre-commit hook: Formatter -> Linter -> Tests. Cualquier fallo aborta el commit.

PY="python -m"
TARGETS="src tests"

paso() { echo ""; echo "==> [$1/3] $2"; }
abortar() {
    echo ""
    echo "XX COMMIT RECHAZADO: fallo en la etapa '$1'. Corregi el problema y volve a intentar."
    exit 1
}

paso 1 "Formatter (black --check)"
$PY black --check --diff $TARGETS || abortar "Formatter"

paso 2 "Linter (flake8)"
$PY flake8 $TARGETS || abortar "Linter"

paso 3 "Tests unitarios + cobertura minima (pytest)"
$PY pytest -q --cov --cov-fail-under=90 || abortar "Tests"

echo ""
echo "OK Todos los controles pasaron. Se crea el commit."
exit 0
